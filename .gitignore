build/
dist/
*.exe
__pycache__/
*.pyc
installer/output/

# Editor / tool directories
.vscode/
.cursor/
.claude/

# Node (mobile/ Capacitor project)
node_modules/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/build/
mobile/android/local.properties

# Android release signing secrets — never commit
mobile/android/keystore.properties
*.jks
*.keystore

# Рабочее пространство subagent-driven development (журнал, брифы, отчёты)
.superpowers/

# Local git worktrees used for isolated plan execution
.worktrees/
